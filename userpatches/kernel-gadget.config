# Kernel symbols the dwc2 USB gadget (Orbit goggles AOA link) needs. The
# Amlogic "meson64" kernel usually already ships these as modules for Android
# ADB/gadget, so a rebuild is often NOT needed -- check first on the box with:
#   zcat /proc/config.gz | grep -E 'DWC2|CONFIGFS|LIBCOMPOSITE|GADGET'
# If any are missing, build with KERNEL_CONFIGURE=yes and enable them (this
# file is a reference list; Armbian does not auto-merge fragments).
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_DWC2=m
# dwc2 must be able to act as a device. DUAL_ROLE lets dr_mode in the device
# tree pick host/peripheral/otg; PERIPHERAL forces device-only.
CONFIG_USB_DWC2_DUAL_ROLE=y
